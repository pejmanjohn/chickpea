{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "chickpea-routines-runtime-spike",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTINE_STATE_SPIKE",
        "class_name": "RoutineStateSpike"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoutineStateSpike", "FlueRoutineSpikeWorkflow", "FlueRegistry"]
    }
  ]
}
