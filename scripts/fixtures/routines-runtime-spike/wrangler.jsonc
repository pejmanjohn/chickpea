{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "chickpea-routines-runtime-spike",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueRoutineSpikeWorkflow", "FlueRegistry"]
    }
  ]
}
