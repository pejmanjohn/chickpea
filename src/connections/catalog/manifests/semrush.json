{
  "toolkit": "semrush",
  "version": "20261014_00",
  "auth": {
    "mode": "api_key",
    "fields": [
      "generic_api_key"
    ]
  },
  "label": "Semrush",
  "description": "Look up keyword search volume, cost per click, and difficulty, and backlink and Authority Score summaries for domains and URLs.",
  "securityDescription": "Semrush connects with an API key entered on Composio's hosted page; Chickpea never receives the key. Agents can look up keyword overviews, search volume, cost per click, and Keyword Difficulty in one or all of Semrush's regional databases, read backlink overviews and Authority Score profiles for a domain or URL, compare backlink profiles across several domains or URLs, and check how many API units the account has left. Every report uses the account's Semrush API units. Row-by-row reports such as keyword lists, backlink lists, and organic rankings are not available, because one call can use thousands of units. Semrush holds no account data for Agents to change.",
  "preset": {
    "category": "search",
    "accent": "#C190FF"
  },
  "validationCapability": "semrush.account_units_balance",
  "review": {
    "add": [
      "SEMRUSH_AUTHORITY_SCORE_PROFILE",
      "SEMRUSH_BACKLINKS_OVERVIEW",
      "SEMRUSH_BATCH_COMPARISON",
      "SEMRUSH_BATCH_KEYWORD_OVERVIEW",
      "SEMRUSH_KEYWORD_OVERVIEW_ALL_DATABASES",
      "SEMRUSH_KEYWORD_OVERVIEW_ONE_DATABASE"
    ],
    "drop": {},
    "allowArguments": {}
  },
  "capabilities": [
    {
      "id": "semrush.account_units_balance",
      "tool": "SEMRUSH_ACCOUNT_UNITS_BALANCE",
      "toolName": "semrush_account_units_balance",
      "lane": "read",
      "effect": "read",
      "description": "Tool to fetch the remaining Semrush Standard API units for the authenticated account. Use this before launching large batches of Semrush report requests to preflight and fail fast if units are exhausted or below a required threshold.",
      "maxResultBytes": 65536,
      "input": {
        "type": "object",
        "properties": {},
        "description": "Request schema for checking Semrush API units balance."
      }
    },
    {
      "id": "semrush.authority_score_profile",
      "tool": "SEMRUSH_AUTHORITY_SCORE_PROFILE",
      "toolName": "semrush_authority_score_profile",
      "lane": "read",
      "effect": "read",
      "description": "Retrieves the Authority Score (AS) profile for a specified target, showing the count of referring domains that link to the target for each AS value from 0 to 100.",
      "maxResultBytes": 65536,
      "input": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "maxLength": 20000,
            "description": "The target entity (URL, domain, or root domain) for which to retrieve the Authority Score profile. For example, 'example.com', 'https://example.com/blog', or 'blog.example.com'."
          },
          "target_type": {
            "type": "string",
            "maxLength": 20000,
            "enum": [
              "root_domain",
              "domain",
              "url"
            ],
            "description": "Specifies the type of the `target`. Valid options are 'root_domain' (e.g., 'example.com'), 'domain' (e.g., 'blog.example.com', which can be a subdomain), or 'url' (a specific page like 'https://example.com/article')."
          }
        },
        "required": [
          "target",
          "target_type"
        ],
        "description": "Schema for providing the target and its type to retrieve the Authority Score profile."
      }
    },
    {
      "id": "semrush.backlinks_overview",
      "tool": "SEMRUSH_BACKLINKS_OVERVIEW",
      "toolName": "semrush_backlinks_overview",
      "lane": "read",
      "effect": "read",
      "description": "Provides a semicolon-delimited (sep=';') CSV summary of backlinks, including Authority Score and link type breakdowns, for a specified and publicly accessible domain, root domain, or URL. A result of 'ERROR 50 :: NOTHING FOUND' means the target has no data in the database and is a valid zero-result response.",
      "maxResultBytes": 65536,
      "input": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "maxLength": 20000,
            "description": "The domain (e.g., 'example.com'), subdomain (e.g., 'blog.example.com'), or URL (e.g., 'https://example.com/page') for backlink analysis."
          },
          "target_type": {
            "type": "string",
            "maxLength": 20000,
            "enum": [
              "root_domain",
              "domain",
              "url"
            ],
            "description": "The type of the `target` (e.g., 'root_domain', 'domain', 'url')."
          },
          "export_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000,
              "enum": [
                "ascore",
                "total",
                "domains_num",
                "urls_num",
                "ips_num",
                "ipclassc_num",
                "follows_num",
                "nofollows_num",
                "sponsored_num",
                "ugc_num",
                "texts_num",
                "images_num",
                "forms_num",
                "frames_num"
              ]
            },
            "maxItems": 100,
            "description": "Specifies columns for the CSV output. If omitted, all columns from `ExportColumns` are included. For available column names, see the `ExportColumns` enum."
          }
        },
        "required": [
          "target",
          "target_type"
        ],
        "description": "Parameters for the Backlinks Overview action."
      }
    },
    {
      "id": "semrush.batch_comparison",
      "tool": "SEMRUSH_BATCH_COMPARISON",
      "toolName": "semrush_batch_comparison",
      "lane": "read",
      "effect": "read",
      "description": "Compares backlink profiles for multiple specified targets (domains, subdomains, or URLs) to analyze and compare link-building efforts.",
      "maxResultBytes": 65536,
      "input": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "maxItems": 100,
            "description": "A list of target domains, subdomains, or URLs for which to retrieve backlink comparison data."
          },
          "target_types": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000,
              "enum": [
                "root_domain",
                "domain",
                "url"
              ]
            },
            "maxItems": 100,
            "description": "Specifies the type for each corresponding target in 'targets'. Ensure this list aligns with 'targets' in order and count for accurate processing."
          },
          "export_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000,
              "enum": [
                "target",
                "target_type",
                "ascore",
                "backlinks_num",
                "domains_num",
                "ips_num",
                "follows_num",
                "nofollows_num",
                "texts_num",
                "images_num",
                "forms_num",
                "frames_num"
              ]
            },
            "maxItems": 100,
            "description": "Specific columns to include in the report. Defaults to all columns. An empty list may result in specific API behavior, like returning a default or minimal set of columns."
          }
        },
        "required": [
          "targets",
          "target_types"
        ],
        "description": "Request schema for `BatchComparison`"
      }
    },
    {
