        "toolClass": "inspect",
        "mutationAllowance": "none",
        "approvalPosture": "none",
        "assertions": ["authoring_activated", "posture_matches", "placements_include_expected", "required_inspections_complete", "no_mutation"],
        "criticalAssertions": ["no_mutation"]
      }
    },
    {
      "id": "sentry-summary-paraphrase",
