{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chickpea",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Without this, a fresh install captures NO logs at all — the sanitized
  // Slack error is then the only trace of a provider failure (learned the
  // hard way: the raw error behind a keyless-anthropic 401 was unrecoverable).
  "observability": {
    "enabled": true,
    // Flue spans are registered explicitly in the Cloudflare-only entry with
    // `content: false`; platform tracing exports operational metadata only.
    "traces": { "enabled": true }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    // Cloudflare-only routine kill switch. Keep "0" through deployment and
    // workerd verification; set "1" only when the fixed Cron, TAG_STATE, and
    // fresh Flue 2 routine agents are present. `npm run deploy` rejects an
    // enabled artifact when any required seam is missing.
    "TAG_ROUTINES_ENABLED": "0",
    // Usage is a fail-open observer of canonical Run/RunExecution records. It
    // never controls admission or delivery, so the release artifact can keep
    // capture, estimates, and the authenticated dashboard enabled by default.
    "USAGE_RUNTIME_RECORDING": "1",
    "USAGE_ESTIMATES": "1",
    "USAGE_ADMIN_UI": "1",
    "CHICKPEA_INSTALLATION_ID": "chickpea",
    // Immutable expiry for newly written canonical Run bodies. Existing rows
    // keep the expiry captured when they were written.
    "TAG_RUN_BODY_RETENTION_DAYS": "30",
    // Exact workspace/channel pairs (`T123/C456`) for the internal interactive
    // ledger canary. Empty keeps every future Slack admission on legacy.
    "SLACK_TAG_LEDGER_CANARY_CHANNELS": ""
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  // App-owned state Durable Object (src/cloudflare.ts): one singleton instance
  // hosts config agents/assignments, thread snapshots, claims, the thread
  // registry, and operator settings on the Cloudflare target. SANDBOX is the
  // Cloudflare Sandbox SDK's per-thread container Durable Object.
  "durable_objects": {
    "bindings": [
      { "name": "TAG_STATE", "class_name": "TagStateStore" },
      { "name": "SANDBOX", "class_name": "Sandbox" },
      { "name": "AUTH_GUARD", "class_name": "AuthGuard" }
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "chickpea-auth-db",
      "database_id": "",
      "migrations_dir": "migrations/better-auth"
    }
  ],
  // v6 is the deliberate prelaunch Flue 2 reset. It permanently deletes only
  // the four beta Flue namespaces and creates fresh v2 agents. TagStateStore,
  // Sandbox, ContainerProxy, and all other app-owned state are preserved.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueRegistry", "FlueSlackThreadAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TagStateStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FlueRoutineWorkflow"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["FlueRoutineIntentAgent"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "FlueChickpeaSlackV2Agent",
        "FlueChickpeaRoutineIntentV2Agent",
        "FlueChickpeaRoutineExecutionV2Agent"
      ],
      "deleted_classes": [
        "FlueRegistry",
        "FlueSlackThreadAgent",
        "FlueRoutineIntentAgent",
        "FlueRoutineWorkflow"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["AuthGuard"]
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      // Each Slack thread still receives its own Sandbox Durable Object and
      // container. This is only the deployment-wide concurrency ceiling; one
      // would make unrelated threads block each other. Immediate teardown,
      // the idle fallback, and the monthly session cap remain the spend bounds.
      "max_instances": 25
    }
  ]
}
